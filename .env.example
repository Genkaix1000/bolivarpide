# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp / Meta Cloud API
# Token de verificación del webhook (GET hub.challenge). Este valor va también
# en Meta > App > WhatsApp > Configuración > Webhook.
META_WEBHOOK_VERIFY_TOKEN=
# App secret de la app de Meta. Valida la firma X-Hub-Signature-256 del webhook
# y actúa como client_secret en el OAuth (Business Login).
META_APP_SECRET=
# ID de la app de Meta (Business Login). Obligatorio para el enlace self-service.
META_APP_ID=
# Versión de Graph API (p. ej. v22.0). Por defecto v21.0.
META_GRAPH_VERSION=
# Redirect URI del OAuth. Debe coincidir EXACTO con "Valid OAuth redirect URIs"
# de la app de Meta. Default: <NEXT_PUBLIC_SITE_URL>/api/meta/oauth/callback.
META_OAUTH_REDIRECT_URI=

# WhatsApp webhook legacy (ramas n8n, deprecated)
# Shared secret sent by the n8n workflow in the `x-whatsapp-secret` header.
# Make it long and random (e.g. `openssl rand -hex 32`).
WHATSAPP_WEBHOOK_SECRET=

# Web Push (Edge Function send-push)
# Generar: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=